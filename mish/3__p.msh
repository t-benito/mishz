import <std/io.msh> as io use { println };

typedef my_i32 = i32;

pub my_i32 main {
  println("Hello, world!");

  /*
   * I plan to have these...
   * I dont have them yet, though.
   * Currently it needs parentheses.
   * */ 
  if true { println(""); }
  // Explicit colons...
  if true: println("");
  // Last is ), its safe.
  if tru() println("");
}

pub bool tru {
  return true;
}
