// Expected to FAIL: Non-existent properties on types
pub void test_property_access() {
    []u8 slice = "hello";

    // Valid: .len and .ptr are supported
    u64 length = slice.len;

    // Invalid property on slice
    u32 bad_prop = slice.unknown_property;

    // Property on primitive number
    i32 num = 10;
    i32 num_prop = num.len;
}
